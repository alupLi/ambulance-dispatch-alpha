<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.ambulance.controller.MainController"
            styleClass="root-pane">
    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="14" right="16" bottom="10" left="16"/>
            </padding>

            <Label text="Скорая помощь — журнал вызовов" styleClass="title"/>

            <!-- Панель основных действий -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button text="Добавить" onAction="#onAdd" styleClass="primary-button"/>
                <Button fx:id="editButton" text="Изменить" onAction="#onEdit" styleClass="secondary-button"/>
                <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="danger-button"/>
                <Button text="Обновить" onAction="#onRefresh" styleClass="secondary-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Статистика" onAction="#onStatistics" styleClass="secondary-button"/>
                <Button text="Экспорт" onAction="#onExport" styleClass="secondary-button"/>
            </HBox>

            <!-- Поиск, фильтры и сортировка -->
            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="filter-bar">
                <TextField fx:id="searchField" promptText="Поиск: пациент, адрес, телефон, симптомы"
                           HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="statusFilter" prefWidth="140"/>
                <ComboBox fx:id="priorityFilter" prefWidth="160"/>
                <DatePicker fx:id="dateFromPicker" promptText="Дата с" prefWidth="125"/>
                <DatePicker fx:id="dateToPicker" promptText="Дата по" prefWidth="125"/>
                <ComboBox fx:id="sortCombo" prefWidth="210"/>
                <Button text="Сбросить" onAction="#onResetFilters" styleClass="secondary-button"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="callsTable">
            <BorderPane.margin>
                <Insets left="16" right="16"/>
            </BorderPane.margin>
            <columns>
                <TableColumn fx:id="idColumn" text="№" prefWidth="45"/>
                <TableColumn fx:id="patientColumn" text="Пациент" prefWidth="170"/>
                <TableColumn fx:id="addressColumn" text="Адрес" prefWidth="200"/>
                <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="120"/>
                <TableColumn fx:id="priorityColumn" text="Приоритет" prefWidth="100"/>
                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="95"/>
                <TableColumn fx:id="dispatcherColumn" text="Диспетчер" prefWidth="170"/>
                <TableColumn fx:id="createdColumn" text="Создан" prefWidth="125"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="6" styleClass="details-pane">
            <padding>
                <Insets top="10" right="16" bottom="10" left="16"/>
            </padding>
            <Label text="Сведения о выбранном вызове" styleClass="section-title"/>
            <Label fx:id="detailsLabel" wrapText="true" prefHeight="100" minHeight="100"
                   styleClass="details-text"/>
            <Label fx:id="statusBarLabel" styleClass="status-bar"/>
        </VBox>
    </bottom>
</BorderPane>
